        )

        if 1 <= freshness <= 5:
            break

        print("Enter a value between 1 and 5.")

    except ValueError:

        print("Enter a valid number.")


# INPUT 3: PACKAGING QUALITY

print("\n3. PACKAGING QUALITY (1-5)")

while True:

    try:

        packaging = float(
            input("Enter packaging quality: ")
        )

        if 1 <= packaging <= 5:
            break

        print("Enter a value between 1 and 5.")

    except ValueError:

        print("Enter a valid number.")


# INPUT 4: FOOD CONDITION

print("\n4. FOOD CONDITION")

print("Options: Good / Fair / Poor")

condition = input(
    "Enter food condition: "
).strip().title()

while condition not in [
    "Good",
    "Fair",
    "Poor"
]:

    print("Please enter Good, Fair, or Poor.")

    condition = input(
        "Enter food condition: "
    ).strip().title()


# ================================================================
# 16. CREATE NEW FOOD RECORD
# ================================================================

new_food = pd.DataFrame({

    "food_temperature": [temperature],

    "food_freshness": [freshness],

    "packaging_quality": [packaging],

    "food_condition": [condition]

})


# ================================================================
# 17. PREDICT SENTIMENT USING KNN
# ================================================================

predicted_sentiment = best_model.predict(
    new_food
)[0]


# ================================================================
# 18. CALCULATE OVERALL FOOD QUALITY SCORE
# ================================================================

temperature_score = {
    "Hot": 5,
    "Warm": 3,
    "Cold": 1
}

condition_score = {
    "Good": 5,
    "Fair": 3,
    "Poor": 1
}

quality_values = [
    temperature_score[temperature],
    freshness,
    packaging,
    condition_score[condition]
