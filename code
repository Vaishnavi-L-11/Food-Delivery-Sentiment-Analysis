)

print("\nBest Classifier: KNN")

print(
    "Predicted Customer Sentiment:",
    predicted_sentiment
)

if predicted_sentiment == "Positive":

    print("Result: Positive customer sentiment.")

elif predicted_sentiment == "Negative":

