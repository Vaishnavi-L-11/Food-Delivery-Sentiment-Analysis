    quality_values
)


# ================================================================
# 19. FINAL FOOD QUALITY PREDICTION
# ================================================================

print("\n" + "=" * 65)

print("FINAL FOOD QUALITY PREDICTION")

print("=" * 65)

print("\nFood Temperature:", temperature)

print("Food Condition:", condition)

print("Packaging Quality:", packaging)

print("Food Freshness:", freshness)

print(
    "\nOverall Food Quality Score:",
    round(overall_quality_score, 2),
